# Copy to .env.local for local development, and set the same names in your hosting provider.
# Never commit real values.

# Supabase: Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side only. Never expose this in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
NEXT_PUBLIC_RESUME_BUCKET=resumes

# Admin login: generate both with `node scripts/generate-admin-credentials.js`
ADMIN_PASSWORD_HASH=scrypt:...
SESSION_SECRET=at-least-32-random-characters

# Public address of the deployed site (used for links in search results and social previews)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
